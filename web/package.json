{
  "name": "jinvoice-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "node server/prod.mjs",
    "pkg:build:win": "npm run build && npx pkg server/launcher.cjs --target node22-win-x64 --output release/pkg/jInvoice.exe --public-packages \"*\" --public && node scripts/pkg-package.mjs win",
    "pkg:build:mac": "npm run build && npx pkg server/launcher.cjs --target node22-macos-arm64 --output release/pkg/jInvoice-mac && node scripts/pkg-package.mjs mac",
    "electron:dev": "npm run build && node_modules/.bin/electron .",
    "electron:build:mac": "node electron/prebuild.mjs && npm run build && electron-builder --mac",
    "electron:build:win": "node electron/prebuild.mjs && npm run build && electron-builder --win"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "dexie": "^3.2.7",
    "dexie-react-hooks": "^4.4.0",
    "express": "^5.2.1",
    "imapflow": "^1.7.6",
    "jspdf": "^4.2.1",
    "multer": "^1.4.5-lts.2",
    "pdfjs-dist": "^4.4.168",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@yao-pkg/pkg": "^6.21.0",
    "electron": "^32.3.3",
    "electron-builder": "^26.15.3",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  },
  "pkg": {
    "scripts": "server/launcher.cjs",
    "outputPath": "release/pkg"
  },
  "build": {
    "appId": "com.jinvoice.app",
    "productName": "jInvoice",
    "copyright": "Copyright © 2025 jInvoice",
    "directories": {
      "output": "release/electron",
      "buildResources": "build"
    },
    "files": [
      "electron/main.mjs",
      "electron/credentials.mjs",
      "server/mobile.mjs",
      "package.json",
      "node_modules/**",
      "!node_modules/.cache/**",
      "!node_modules/.vite/**"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "jInvoice"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.finance",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    }
  }
}
