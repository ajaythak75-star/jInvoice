# Set to your Render/Railway proxy URL for production pkg builds.
# Leave empty for dev (viteAuthPlugin handles auth locally).
VITE_AUTH_BASE=

# Google OAuth (Gmail + Google Login)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# Microsoft / Azure OAuth (Outlook)
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=your-azure-secret

# Overrides the OAuth redirect base URL (required for LAN access / fixed redirect URIs)
AUTH_BASE_URL=http://localhost:5173
