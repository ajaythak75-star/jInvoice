# Set to your Render/Railway proxy URL for production pkg builds.
# Leave empty for dev (viteAuthPlugin handles auth locally).
VITE_AUTH_BASE=

# Google OAuth (Gmail + Google Login)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# Microsoft / Azure OAuth (Outlook)
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=your-azure-secret

# Overrides the OAuth redirect base URL (required for LAN access / fixed redirect URIs)
AUTH_BASE_URL=http://localhost:5173

# Resend (email OTP delivery — https://resend.com, free tier: 3,000/month)
RESEND_API_KEY=re_your_api_key_here
# From address — use onboarding@resend.dev for dev/testing (no domain needed).
# For production, set to an address on your verified Resend domain.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Supabase (magic link session creation)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
